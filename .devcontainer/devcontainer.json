{
  "name": "ubuntu-dind-webstorm",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "jetbrains": {
      "plugins": [
        "org.intellij.prisma",
        "org.intellij.ml.llm"
      ]
    }
  },
  "remoteUser": "root",
  "privileged": true,
  "containerEnv": {
    "DOCKER_BUILDKIT": "1",
    "COMPOSE_DOCKER_CLI_BUILD": "1"
  },
  "postCreateCommand": "docker version && docker compose version || true"
}
