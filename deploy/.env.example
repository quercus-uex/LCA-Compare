TAG=main

DB_USER=
DB_PASSWORD=
JWT_SECRET=
# Opcionales: sin OpenRouter el informe omite el texto generado por IA; sin
# MAILER_* no se envía el correo de alta a los usuarios nuevos
OPENROUTER_API_KEY=
# Modelo de OpenRouter; vacío para usar openai/gpt-oss-120b:nitro
OPENROUTER_MODEL=
MAILER_EMAIL=
MAILER_PASSWORD=
# Servidor SMTP; vacío para usar Gmail
MAILER_HOST=
MAILER_PORT=587
CALC_API_KEY=
DEFAULT_IMPACT_METHOD_UUID=2f995579-06bd-4681-b07c-cee3b1805b0d

# Datos de openLCA (base ecoinvent), fuera de la imagen por licencia
OLCA_DATA_DIR=/opt/openlca-data

BACKUP_SCHEDULE="0 3 * * *"
BACKUP_LOCAL_ENABLED=true
BACKUP_LOCAL_DIR=./backups
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-south-2
BACKUP_S3_BUCKET=lca-compare-backup
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
