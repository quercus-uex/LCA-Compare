{
  "name": "lca-compare",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "dev": "turbo dev --ui=tui",
    "server:build": "pnpm --filter server build",
    "server:dev": "pnpm --filter server start:dev",
    "server:start": "pnpm --filter server start",
    "server:start:prod": "pnpm --filter server start:prod",
    "server:test": "pnpm --filter server test",
    "server:lint": "pnpm --filter server lint",
    "server:prisma:generate": "pnpm --filter server prisma:generate",
    "server:prisma:migrate:deploy": "pnpm --filter server prisma:migrate:deploy",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "docs:dev": "pnpm --filter docs start",
    "docs:build": "pnpm --filter docs build",
    "docs:typecheck": "pnpm --filter docs typecheck"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
