<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <title>Reporte de comparativa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      @page { size: A4 portrait; margin: 20mm; }
      body { margin: 0; padding: 0; background: #ccc; }
      .page {
          width: 210mm;
          min-height: 297mm;
          padding: 1mm;
          margin: 10mm auto;
          background: white;
          box-sizing: border-box;
          box-shadow: 0 0 8px rgba(0,0,0,0.3);
      }
      @media print {
          body { background: none; }
          .page {
              margin: 0;
              box-shadow: none;
              break-after: page;
          }
          h1, h2, h3, table, img {
              break-inside: avoid;
          }
      }
      .google-sans-all {
          font-family: "Google Sans", sans-serif;
          font-optical-sizing: auto;
          font-weight: 500;
          font-style: normal;
          font-variation-settings:
          "GRAD" 0;
      }

    </style>

  </head>

  <body class="google-sans-all">
    <div class="page">
      <div class="flex flex-col gap-5 items-center">
        <h1 class="text-3xl font-bold">Informe de comparativa</h1>
        <div class="card w-full">
          <div class="card-body bg-gray-100 rounded-lg p-2 flex flex-col items-center gap-2">
            <h2 class="text-gray-700 grow font-bold">FILTROS SELECCIONADOS</h2>
            <div class="flex gap-2 w-full">
              <div class="card w-full h-full">
                <div class="card-body rounded-xl border border-blue-200">
                  <div class="w-full bg-blue-100 p-2 rounded-tl-xl rounded-tr-xl flex gap-2 items-center">
                    <div class="rounded-full w-2 h-2 bg-blue-600"></div>
                    <h3 class="text-blue-600">Conjunto de referencia</h3>
                  </div>
                  <div class="w-full flex flex-col gap-2 p-5">
                    {{#if refProvincias}}
                      <div class="flex justify-between gap-2">
                        <p>Provincias: </p>
                        <div class="flex gap-2 flex-wrap">
                          {{#each refProvincias}}
                            <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{nombre}}</span>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}
                    {{#if refPoblaciones}}
                      <div class="flex justify-between gap-2">
                        <p>Poblaciones: </p>
                        <div class="flex gap-2 flex-wrap">
                          {{#each refPoblaciones}}
                            <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{nombre}}</span>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}
                    {{#if refFilters.lat}}
                      <div class="flex justify-between">
                        <p>Ubicación: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{decimals refFilters.lat 5}}, {{decimals refFilters.long 5}}</span>
                        </div>
                      </div>
                    {{/if}}
                    {{#if refFilters.range}}
                      <div class="flex justify-between">
                        <p>Rango: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{refFilters.range}} m</span>
                        </div>
                      </div>
                    {{/if}}
                    {{#if refFilters.tipoCultivo}}
                      <div class="flex justify-between">
                        <p>Tipo de cultivo: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{refFilters.tipoCultivo}}</span>
                        </div>
                      </div>
                    {{/if}}
                  </div>
                </div>
              </div>

              <div class="card w-full">
                <div class="card-body rounded-xl border border-red-200">
                  <div class="w-full bg-red-100 p-2 rounded-tl-xl rounded-tr-xl flex gap-2 items-center">
                    <div class="rounded-full w-2 h-2 bg-red-600"></div>
                    <h3 class="text-red-600">Conjunto objetivo</h3>
                  </div>
                  <div class="w-full flex flex-col gap-2 p-5">
                    {{#if tarProvincias}}
                      <div class="flex justify-between gap-2">
                        <p>Provincias: </p>
                        <div class="flex gap-2 flex-wrap">
                          {{#each tarProvincias}}
                            <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{nombre}}</span>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}
                    {{#if tarPoblaciones}}
                      <div class="flex justify-between gap-2">
                        <p>Poblaciones: </p>
                        <div class="flex gap-2 flex-wrap">
                          {{#each tarPoblaciones}}
                            <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{nombre}}</span>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}
                    {{#if tarFilters.lat}}
                      <div class="flex justify-between">
                        <p>Ubicación: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{decimals tarFilters.lat 5}}, {{decimals tarFilters.long 5}}</span>
                        </div>
                      </div>
                    {{/if}}
                    {{#if tarFilters.range}}
                      <div class="flex justify-between">
                        <p>Rango: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{tarFilters.range}} m</span>
                        </div>
                      </div>
                    {{/if}}
                    {{#if tarFilters.tipoCultivo}}
                      <div class="flex justify-between">
                        <p>Tipo de cultivo: </p>
                        <div class="flex gap-2">
                          <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 inset-ring inset-ring-gray-400/20">{{tarFilters.tipoCultivo}}</span>
                        </div>
                      </div>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2 w-full items-center">
          <h2>RESULTADOS CLAVE</h2>

          <div class="flex gap-2 w-full">
            {{#each topImpacts}}
              <div class="card w-full">
                <div class="card-body bg-gray-100 rounded-lg p-5 h-full flex flex-col gap-5 justify-between">
                  <h3 class="card-title line-clamp-2">{{category}}</h3>
                  <div class="flex flex-col gap-1">
                    <p class="text-5xl text-center">{{diff}}%</p>
                    <p class="text-center">
                      <span class="text-blue-600">{{decimals amountRef 6}}</span> vs. <span class="text-red-600">{{decimals amountTar 6}}</span>
                    </p>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </div>

        <div class="card w-full">
          <div class="card-body bg-gray-100 p-2 rounded-lg">
            <div class="flex gap-2 items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
              </svg>
              <h3>RESUMEN</h3>
            </div>

            <p class="font-normal">
              {{overview}}
            </p>

            <span class="text-sm font-thin text-gray-700">
              * Contenido generado por IA. Puede ser inexacto.
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="page flex flex-col gap-2 items-center">
      <p>IMPACTO TOTAL</p>
      <table class="table-auto">
        <thead class="bg-neutral-secondary-soft border-b border-default">
          <tr>
            <th class="text-start">Categoría</th>
            <th class="text-start">Cantidad referencia</th>
            <th class="text-start">Cantidad objetivo</th>
            <th class="text-start">Unidad</th>
            <th class="text-start">Diferencia</th>
          </tr>
        </thead>
        <tbody>
        {{#each result.impacto_total}}
          <tr {{#if (isOdd @index)}}class="bg-gray-200"{{/if}}>
            <td class="line-clamp-1">{{category}}</td>
            <td class="text-blue-600">{{decimals amountRef 5}}</td>
            <td class="text-red-600">{{decimals amountTar 5}}</td>
            <td class="line-clamp-1">{{unit}}</td>
            <td class="">{{diff}} %</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    <div class="page flex flex-col gap-2 items-center">
      <p>IMPACTO DE PESTICIDAS</p>
      <table class="table-auto">
        <thead class="bg-neutral-secondary-soft border-b border-default">
        <tr>
          <th class="text-start">Categoría</th>
          <th class="text-start">Cantidad referencia</th>
          <th class="text-start">Cantidad objetivo</th>
          <th class="text-start">Unidad</th>
          <th class="text-start">Diferencia</th>
        </tr>
        </thead>
        <tbody>
        {{#each result.impacto_pesticidas}}
          <tr {{#if (isOdd @index)}}class="bg-gray-200"{{/if}}>
            <td class="line-clamp-1">{{category}}</td>
            <td class="text-blue-600">{{decimals amountRef 5}}</td>
            <td class="text-red-600">{{decimals amountTar 5}}</td>
            <td class="line-clamp-1">{{unit}}</td>
            <td class="">{{diff}} %</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    <div class="page flex flex-col gap-2 items-center">
      <p>IMPACTO DE FERTILIZANTES</p>
      <table class="table-auto">
        <thead class="bg-neutral-secondary-soft border-b border-default">
        <tr>
          <th class="text-start">Categoría</th>
          <th class="text-start">Cantidad referencia</th>
          <th class="text-start">Cantidad objetivo</th>
          <th class="text-start">Unidad</th>
          <th class="text-start">Diferencia</th>
        </tr>
        </thead>
        <tbody>
        {{#each result.impacto_fertilizantes}}
          <tr {{#if (isOdd @index)}}class="bg-gray-200"{{/if}}>
            <td class="line-clamp-1">{{category}}</td>
            <td class="text-blue-600">{{decimals amountRef 5}}</td>
            <td class="text-red-600">{{decimals amountTar 5}}</td>
            <td class="line-clamp-1">{{unit}}</td>
            <td class="">{{diff}} %</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    <div class="page flex flex-col gap-2 items-center">
      <p>IMPACTO DEL SISTEMA DE RIEGO</p>
      <table class="table-auto">
        <thead class="bg-neutral-secondary-soft border-b border-default">
        <tr>
          <th class="text-start">Categoría</th>
          <th class="text-start">Cantidad referencia</th>
          <th class="text-start">Cantidad objetivo</th>
          <th class="text-start">Unidad</th>
          <th class="text-start">Diferencia</th>
        </tr>
        </thead>
        <tbody>
        {{#each result.impacto_sistema_riego}}
          <tr {{#if (isOdd @index)}}class="bg-gray-200"{{/if}}>
            <td class="line-clamp-1">{{category}}</td>
            <td class="text-blue-600">{{decimals amountRef 5}}</td>
            <td class="text-red-600">{{decimals amountTar 5}}</td>
            <td class="line-clamp-1">{{unit}}</td>
            <td class="">{{diff}} %</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    <div class="page flex flex-col gap-2 items-center">
      <p>IMPACTO DEL MANEJO DEL CULTIVO</p>
      <table class="table-auto">
        <thead class="bg-neutral-secondary-soft border-b border-default">
        <tr>
          <th class="text-start">Categoría</th>
          <th class="text-start">Cantidad referencia</th>
          <th class="text-start">Cantidad objetivo</th>
          <th class="text-start">Unidad</th>
          <th class="text-start">Diferencia</th>
        </tr>
        </thead>
        <tbody>
        {{#each result.impacto_manejo_cultivo}}
          <tr {{#if (isOdd @index)}}class="bg-gray-200"{{/if}}>
            <td class="line-clamp-1">{{category}}</td>
            <td class="text-blue-600">{{decimals amountRef 5}}</td>
            <td class="text-red-600">{{decimals amountTar 5}}</td>
            <td class="line-clamp-1">{{unit}}</td>
            <td class="">{{diff}} %</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  </body>
</html>